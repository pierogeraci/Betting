# Copia in .env e compila (oppure `make env` genera valori casuali).
# Il file .env non va mai nel repository.

POSTGRES_USER=betting
POSTGRES_PASSWORD=CAMBIAMI
POSTGRES_DB=betting

# Ruolo ristretto usato dai contenitori di raccolta: vede solo la coda.
RACCOLTA_DB_PASSWORD=CAMBIAMI

# Archivio a oggetti compatibile S3 (SeaweedFS in locale)
S3_BUCKET=betting-grezzi
S3_BUCKET_ARRIVO=betting-arrivo
S3_ACCESS_KEY=CAMBIAMI
S3_SECRET_KEY=CAMBIAMI
# Chiave dei contenitori di raccolta: può solo scrivere nel secchio di arrivo.
RACCOLTA_S3_ACCESS_KEY=CAMBIAMI
RACCOLTA_S3_SECRET_KEY=CAMBIAMI

# Portale
PORTA_PORTALE=8000
COOKIE_SICURI=false
ADM_GIORNI_VALIDITA=30

# Tetto di pagine all'ora per il contenitore di raccolta
RACCOLTA_MAX_PAGINE_ORA=120

# Prova su dati reali: al massimo tre URL separati da virgola
PROVA_URLS=

# Telegram: sonda attiva. Mettere false per spegnerla senza toccare il codice.
TELEGRAM_PROBE_ENABLED=true
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Proxy SOCKS del contenitore Tor
TOR_SOCKS_URL=socks5h://tor:9050

# Uso dalla macchina di sviluppo (make test, make lint)
DATABASE_URL=postgresql://betting:CAMBIAMI@localhost:5432/betting
S3_ENDPOINT=http://localhost:8333
