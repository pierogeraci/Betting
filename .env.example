# Copia in .env e compila. Il file .env non va mai nel repository.

DATABASE_URL=postgresql://betting:CAMBIAMI@localhost:5432/betting
REDIS_URL=redis://localhost:6379/0

# Archivio a oggetti compatibile S3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=betting-grezzi
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Telegram: sonda attiva. Mettere false per spegnerla senza toccare il codice.
TELEGRAM_PROBE_ENABLED=true
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Proxy SOCKS del contenitore Tor
TOR_SOCKS_URL=socks5h://tor:9050
